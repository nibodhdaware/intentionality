{
    "manifest_version": 3,
    "name": "Intentionality – Intentional Browsing & Focused Productivity",
    "short_name": "Intentionality",
    "version": "1.2",
    "description": "Build the habit of focus. Block distractions, browse with intention, and set mindful time limits with Intentionality.",
    "homepage_url": "https://intentionality.app/",
    "author": "Intentionality Team",
    "oauth2": {
        "client_id": "938266027514-vgh2o1odih2hbqpae8h2qe0kbe1ugk94.apps.googleusercontent.com",
        "scopes": ["email", "profile"]
    },
    "permissions": [
        "storage",
        "tabs",
        "webNavigation",
        "notifications",
        "scripting"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "web_accessible_resources": [
        {
            "resources": ["why_prompt.html", "lib/*"],
            "matches": ["<all_urls>"]
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    },
    "externally_connectable": {
        "matches": ["https://intentionality.app/*"]
    }
}
