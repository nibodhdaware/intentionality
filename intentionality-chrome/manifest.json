{
    "manifest_version": 2,
    "name": "Intentionality – Intentional Browsing & Focused Productivity",
    "short_name": "Intentionality",
    "version": "1.2",
    "description": "Build the habit of focus. Block distractions, browse with intention, and set mindful time limits with Intentionality.",
    "homepage_url": "https://intentionality.app/",
    "author": "Intentionality Team",
    "permissions": [
        "storage",
        
        "notifications",
        "tabs",
        "webNavigation",
        "<all_urls>"
    ],
    "browser_action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "background": {
        "scripts": ["background.js"]
    },
    "web_accessible_resources": [
        "why_prompt.html", 
        "lib/*"
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "intentionality@intentionality.app"
        }
    },
    "content_security_policy": "script-src 'self'; object-src 'self'",
    "externally_connectable": {
        "matches": ["https://intentionality.app/"]
    }
}