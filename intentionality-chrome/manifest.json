{
    "manifest_version": 3,
    "name": "Intentionality – Intentional Browsing & Focused Productivity",
    "short_name": "Intentionality",
    "version": "1.6",
    "description": "Build the habit of focus. Block distractions, browse with intention, and set mindful time limits with Intentionality.",
    "homepage_url": "https://intentionality.app/",
    "author": "Intentionality Team",
    
    "permissions": [
        "storage",
        "scripting",
        "notifications",
        "tabs",
        "webNavigation",
        "alarms"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_popup_dimensions": {
            "width": 380,
            "height": 600
        },
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "background": {
        "service_worker": "service-worker.js",
        "type": "module"
    },
    "web_accessible_resources": [
        {
            "resources": ["why_prompt.html", "lib/*"],
            "matches": ["https://intentionality.app/*"]
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    }
}
